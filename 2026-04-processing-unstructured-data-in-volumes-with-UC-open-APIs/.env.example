# Databricks workspace URL (required)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Unity Catalog and schema (required)
UC_CATALOG=<your-catalog>
UC_SCHEMA=<your-schema>

# Volume names (just the volume name, not the full catalog.schema.volume path)
DATABRICKS_FILE_VOLUME_NAME=<your-tabular-volume>
DATABRICKS_IMAGE_VOLUME_NAME=<your-image-volume>

# Comma-separated image filenames in the volume (required)
IMAGE_FILENAMES=<comma-separated image filenames>

# AWS region for S3 access (e.g., us-east-1)
AWS_REGION=<your-aws-region>
