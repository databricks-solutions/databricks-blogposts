{
  "datasets": [
    {
      "name": "flagged_detail",
      "displayName": "Flagged detail",
      "queryLines": [
        "WITH recent AS (SELECT *, reason LIKE 'CANDIDATE\\\\_%' AS from_scan FROM maintenance.cleanup.cleanup_log WHERE timestamp >= current_timestamp() - INTERVAL 7 DAYS), state AS (SELECT * FROM recent WHERE dry_run AND NOT from_scan QUALIFY ROW_NUMBER() OVER (PARTITION BY environment, resource_type, resource_id ORDER BY timestamp DESC) = 1), scan AS (SELECT * FROM recent WHERE from_scan AND action = 'FLAGGED' QUALIFY timestamp >= max(timestamp) OVER (PARTITION BY environment) - INTERVAL 15 MINUTES AND ROW_NUMBER() OVER (PARTITION BY environment, resource_type, resource_id ORDER BY timestamp DESC) = 1), flags AS (SELECT * FROM state WHERE action = 'FLAGGED' UNION ALL SELECT s.* FROM scan s WHERE NOT EXISTS (SELECT 1 FROM state f WHERE f.action = 'FLAGGED' AND f.environment = s.environment AND f.resource_type = s.resource_type AND f.resource_id = s.resource_id)), open_flags AS (SELECT f.* FROM flags f WHERE NOT EXISTS (SELECT 1 FROM recent d WHERE d.action = 'DELETED' AND d.environment = f.environment AND d.resource_type = f.resource_type AND d.resource_id = f.resource_id AND d.timestamp >= f.timestamp)) SELECT environment, resource_type, resource_name, resource_id, reason, owner, timestamp, CASE WHEN from_scan THEN 0 ELSE 1 END AS deletable FROM open_flags ORDER BY timestamp DESC"
      ]
    },
    {
      "name": "action_breakdown",
      "displayName": "Action breakdown",
      "queryLines": [
        "WITH recent AS (SELECT * FROM maintenance.cleanup.cleanup_log WHERE timestamp >= current_timestamp() - INTERVAL 7 DAYS QUALIFY ROW_NUMBER() OVER (PARTITION BY environment, resource_type, resource_id, action ORDER BY timestamp DESC) = 1) SELECT environment, action, COUNT(*) AS n FROM recent GROUP BY environment, action"
      ]
    },
    {
      "name": "pending_approvals",
      "displayName": "Pending approvals",
      "queryLines": [
        "WITH approvals AS (SELECT environment, resource_type, resource_id, max_by(approved_by, approved_at) AS approved_by, max(approved_at) AS approved_at FROM maintenance.cleanup.cleanup_approvals WHERE approved_at >= current_timestamp() - INTERVAL 7 DAYS GROUP BY environment, resource_type, resource_id), names AS (SELECT environment, resource_type, resource_id, max_by(resource_name, timestamp) AS resource_name FROM maintenance.cleanup.cleanup_log WHERE timestamp >= current_timestamp() - INTERVAL 30 DAYS GROUP BY environment, resource_type, resource_id), deletions AS (SELECT environment, resource_type, resource_id, max(timestamp) AS deleted_at FROM maintenance.cleanup.cleanup_log WHERE action = 'DELETED' GROUP BY environment, resource_type, resource_id) SELECT a.environment, a.resource_type, n.resource_name, a.resource_id, a.approved_by, a.approved_at, a.approved_at + INTERVAL 7 DAYS AS expires_at FROM approvals a LEFT JOIN names n USING (environment, resource_type, resource_id) LEFT JOIN deletions x USING (environment, resource_type, resource_id) WHERE x.deleted_at IS NULL OR x.deleted_at < a.approved_at ORDER BY expires_at"
      ]
    },
    {
      "name": "recent_deletions",
      "displayName": "Recent deletions",
      "queryLines": [
        "WITH d AS (SELECT * FROM maintenance.cleanup.cleanup_log WHERE action = 'DELETED' AND timestamp >= current_timestamp() - INTERVAL 30 DAYS), a AS (SELECT d.environment, d.resource_type, d.resource_id, d.timestamp, ap.approved_by, ap.approved_at FROM d JOIN maintenance.cleanup.cleanup_approvals ap ON ap.environment = d.environment AND ap.resource_type = d.resource_type AND ap.resource_id = d.resource_id AND ap.approved_at <= d.timestamp QUALIFY ROW_NUMBER() OVER (PARTITION BY d.environment, d.resource_type, d.resource_id, d.timestamp ORDER BY ap.approved_at DESC) = 1) SELECT d.timestamp AS deleted_at, d.environment, d.resource_type, d.resource_name, d.resource_id, COALESCE(get_json_object(d.details, '$.approved_by'), a.approved_by) AS approved_by, COALESCE(CAST(get_json_object(d.details, '$.approved_at') AS TIMESTAMP), a.approved_at) AS approved_at, d.reason FROM d LEFT JOIN a ON a.environment = d.environment AND a.resource_type = d.resource_type AND a.resource_id = d.resource_id AND a.timestamp = d.timestamp ORDER BY deleted_at DESC"
      ]
    }
  ],
