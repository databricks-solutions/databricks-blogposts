# Optional overrides. The workspace is chosen with -p <profile> (a Databricks CLI profile).
UC_CATALOG=uc_views_demo
# Order dates copied from samples.tpch
# TPCH_FROM=1998-01-01
# TPCH_TO=1998-03-31
# Needed if the metastore has no root storage (CREATE CATALOG ... MANAGED LOCATION)
# UC_MANAGED_LOCATION=s3://<bucket>/<path>
# Use an existing SQL warehouse instead of finding/creating "uc-views-demo" (destroy.py never deletes it)
# DATABRICKS_WAREHOUSE_ID=<id>
# DEMO_WAREHOUSE_NAME=uc-views-demo
# DEMO_READER_SP_NAME=uc-views-demo-reader
# If your network blocks Maven Central, use a mirror
# SPARK_REPOSITORIES=https://<maven-mirror>
