# Local development settings. Copy to .env.local and fill in.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=janus
DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>
VS_ENDPOINT_NAME=janus_vs_endpoint
AGENT_MODEL=databricks-claude-sonnet-5-5
JUDGE_MODEL=databricks-claude-opus-5-5
EMBEDDING_MODEL=databricks-bge-large-en
